<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.Ep00Provider</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Ep00Provider</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- The provider ships SpikeContracts 2.0.0; the host ships 1.0.0. -->
    <SpikeContractsVersion>2.0.0</SpikeContractsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc1" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc1" />
    <ProjectReference Include="../SpikeContracts/SpikeContracts.csproj" />
  </ItemGroup>
</Project>
